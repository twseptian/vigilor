# ── Stage 1: Build React app ──────────────────────────────────────────────────
FROM node:20-slim AS builder

WORKDIR /app

# Copy package files first for better layer caching
COPY development-ui-version/frontend/package*.json ./

# Install dependencies inside container (correct platform binaries)
RUN npm install --prefer-offline --no-audit --no-fund

# Copy frontend source
COPY development-ui-version/frontend/src ./src
COPY development-ui-version/frontend/public ./public
COPY development-ui-version/frontend/index.html ./
COPY development-ui-version/frontend/vite.config.ts ./
COPY development-ui-version/frontend/tsconfig*.json ./
COPY development-ui-version/frontend/tailwind.config.ts ./
COPY development-ui-version/frontend/postcss.config.js ./

# Build production bundle
RUN npm run build

# ── Stage 2: Serve with nginx ─────────────────────────────────────────────────
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY development-ui-version/docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
