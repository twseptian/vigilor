# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="VIGILOR"
DEBUG=false
FRONTEND_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (dev):
DATABASE_URL=sqlite+aiosqlite:///./pentest_ui.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pentest_ui

# ── Auth — CHANGE THESE IN PRODUCTION ────────────────────────────────────────
SECRET_KEY=generate-with-openssl-rand-hex-32
ENCRYPTION_KEY=generate-32-byte-key-for-aes-encryption

# ── First admin (used only if DB is empty on startup) ────────────────────────
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=changeme123
FIRST_ADMIN_EMAIL=admin@localhost

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Reports ──────────────────────────────────────────────────────────────────
REPORTS_DIR=./reports
