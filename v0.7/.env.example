# ── LLM Provider API Keys ──────────────────────────────────────────────────────
# Required for --provider claude (default)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required for --provider openai
OPENAI_API_KEY=your_openai_api_key_here

# ── Ollama Local Model (used when --provider ollama) ───────────────────────────
# URL of your running Ollama server
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model to use — any model pulled via `ollama pull <model>`
OLLAMA_MODEL=qwen2.5-coder:7b-instruct

# Context window size (tokens). Increase for larger targets (max depends on model)
OLLAMA_NUM_CTX=8192

# Temperature — lower = more deterministic JSON output (recommended: 0.1)
OLLAMA_TEMPERATURE=0.1

# ── Optional ───────────────────────────────────────────────────────────────────
# MAX_CONCURRENT_AGENTS=3
# TARGET_URL=http://localhost:3000
