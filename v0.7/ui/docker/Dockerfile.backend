FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Install Playwright first (large layer — cache before requirements.txt changes)
RUN pip install --no-cache-dir playwright && playwright install chromium --with-deps

# Install backend dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend source
COPY backend/ ./backend/

# Copy pentest engine (core + agents + tools + prompts)
COPY src/ ./src/

# Bundle the report template
COPY backend/report_template.docx /app/report_template.docx

# Copy Alembic config and migrations
COPY backend/alembic.ini .
COPY backend/migrations/ ./migrations/

EXPOSE 8000

CMD ["sh", "-c", \
  "cp -n /app/report_template.docx /app/data/report_template.docx 2>/dev/null || true \
   && alembic upgrade head \
   && uvicorn backend.main:app --host 0.0.0.0 --port 8000"]
