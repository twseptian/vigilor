# ─────────────────────────────────────────────────────────────────────────────
#  Agentic Web Pentest — v0.7.0
#  Copy this file to .env and fill in values before running ./start.sh
# ─────────────────────────────────────────────────────────────────────────────

# ── Security (REQUIRED — change before production use) ────────────────────────
# Generate SECRET_KEY with:  openssl rand -hex 32
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32

# Generate ENCRYPTION_KEY with:  openssl rand -base64 32
ENCRYPTION_KEY=changeme-32-byte-key-base64-encoded

# ── Admin account (first start only — won't update if DB already exists) ──────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
ADMIN_EMAIL=admin@localhost

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=pentest
DB_PASSWORD=changeme-db-password

# ── Ports ─────────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ── CORS — comma-separated list of allowed origins ────────────────────────────
# Add your server IP/hostname if users access from another machine.
# Example (server at 192.168.1.100):
# CORS_ORIGINS=http://localhost,http://localhost:3000,http://192.168.1.100,http://192.168.1.100:3000
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000
