# ============================================================
# Cloud LLM API Keys
# ============================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================
# Ollama Local Server  (used when --provider ollama)
# To switch model: just change OLLAMA_MODEL below, then run.
# ============================================================

# Ollama server address
OLLAMA_BASE_URL=http://172.30.48.1:11434

# ── Model selection ──────────────────────────────────────────
# Change this line to switch model. No code change needed.
#
# Recommended models (pull with: ollama pull <model>):
#
#  General-purpose (best quality):
#   OLLAMA_MODEL=qwen2.5-coder:32b-instruct        # best accuracy, needs ~20GB VRAM
#   OLLAMA_MODEL=qwen2.5-coder:14b-instruct        # good balance, ~8GB VRAM
#   OLLAMA_MODEL=qwen2.5-coder:7b-instruct         # standard, ~5GB VRAM
#
#  Security-tuned (recommended for pentest):
#   OLLAMA_MODEL=qwen2.5-coder:7b-infosec          # default — security fine-tune
#   OLLAMA_MODEL=llama3.1:8b                       # good tool calling support
#   OLLAMA_MODEL=mistral-nemo:12b                  # strong reasoning
#   OLLAMA_MODEL=deepseek-coder-v2:16b             # excellent code/security
#
#  Lightweight (low VRAM, limited accuracy):
#   OLLAMA_MODEL=qwen2.5-coder:3b-instruct         # ~2GB VRAM, basic only
#   OLLAMA_MODEL=phi3.5:3.8b                       # ~2.5GB VRAM
#
OLLAMA_MODEL=qwen2.5-coder:7b-infosec

# ── Context window ───────────────────────────────────────────
# Number of tokens Ollama keeps in memory per session.
# Increase for longer multi-turn conversations (uses more VRAM).
#   8192  → default, suitable for most 7B-14B models
#   16384 → recommended for 32B models
#   4096  → use if VRAM is limited
OLLAMA_NUM_CTX=8192

# ── Temperature ──────────────────────────────────────────────
# Lower = more deterministic (better for tool calls & JSON).
# Higher = more creative (may cause unstable tool use).
#   0.1 → recommended for security testing (default)
#   0.7 → use for report narrative generation only
OLLAMA_TEMPERATURE=0.1

# ============================================================
# Optional pipeline configuration
# ============================================================
# MAX_CONCURRENT_AGENTS=3
# TARGET_URL=http://localhost:3000
